#!/bin/bash
# Hootty PostToolUse (shell) hook for OpenAI Codex CLI — reads cwd from
# the hook's stdin JSON payload and emits OSC 7 directly to /dev/tty so
# ghostty updates the pane's working directory (enables worktree detection
# in the sidebar while Codex is running). Hook stdout is consumed by the
# Codex hook subsystem, so the OSC sequence must go to /dev/tty.
CWD=$(tr -d '\n' | sed -n 's/.*"cwd" *: *"\([^"]*\)".*/\1/p')
[ -z "$CWD" ] && CWD="$(pwd)"
[ -n "$CWD" ] && printf '\e]7;file://%s%s\a' "$(hostname)" "$CWD" > /dev/tty 2>/dev/null
exit 0
