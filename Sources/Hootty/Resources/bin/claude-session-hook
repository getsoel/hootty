#!/bin/bash
# Hootty SessionStart hook — extract Claude Code's session_id from the hook JSON
# on stdin and report it to Hootty (OSC 9 hootty:resume) so the conversation can
# be resumed after a crash/restart.
#
# MUST write to the pane PTY, NOT stdout: some hook events (SessionStart,
# UserPromptSubmit) fold a hook's stdout into the model's context, which would
# leak the escape sequence into the conversation and never reach ghostty's
# parser. Writing to the PTY bypasses that capture (same approach as
# claude-presence-hook); hootty-tty.sh resolves the device.
#
# Includes CLAUDE_CONFIG_DIR (when set) so config-dir-scoped sessions — whose
# transcripts live under ~/.claude-<x>/projects/… — can be resolved on resume.
SID=$(tr -d '\n' | sed -n 's/.*"session_id":"\([^"]*\)".*/\1/p' | head -1)
[ -z "$SID" ] && exit 0
PAYLOAD="$SID"
[ -n "$CLAUDE_CONFIG_DIR" ] && PAYLOAD="$SID|$CLAUDE_CONFIG_DIR"
# Group-redirect stderr so a missing PTY (headless/CI runs) can't leak a
# "cannot open" message — the open failure itself is on fd 2.
. "$(dirname "$0")/hootty-tty.sh"
{ printf '\e]9;hootty:resume:%s\a' "$PAYLOAD" > "$HOOTTY_OSC_TTY"; } 2>/dev/null
exit 0
