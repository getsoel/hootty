#!/bin/bash
# Hootty cwd hook — reads cwd from the hook's stdin JSON payload and emits
# OSC 7 to the pane PTY so ghostty updates the pane's working directory
# (enables worktree detection in the sidebar). Falls back to pwd if the JSON
# doesn't contain a cwd field. Hook stdout is consumed by agent CLI hook
# subsystems (Gemini, Codex) as a structured response channel, so the OSC
# sequence must be written to the pane PTY, which hootty-tty.sh resolves.
. "$(dirname "$0")/hootty-tty.sh"
CWD=$(tr -d '\n' | sed -n 's/.*"cwd" *: *"\([^"]*\)".*/\1/p')
[ -z "$CWD" ] && CWD="$(pwd)"
[ -n "$CWD" ] && printf '\e]7;file://%s%s\a' "$(hostname)" "$CWD" > "$HOOTTY_OSC_TTY" 2>/dev/null
exit 0
