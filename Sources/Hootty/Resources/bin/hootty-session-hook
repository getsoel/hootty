#!/bin/bash
# Hootty SessionStart hook — emits an OSC 9 session marker to the pane PTY.
# Hook stdout is consumed by agent CLI hook subsystems (Gemini, Codex) as a
# structured response channel, so OSC sequences must go to the PTY instead,
# which hootty-tty.sh resolves.
. "$(dirname "$0")/hootty-tty.sh"
[ -n "$HOOTTY_PANE_ID" ] && printf '\e]9;hootty:session:%s\a' "$HOOTTY_PANE_ID" > "$HOOTTY_OSC_TTY" 2>/dev/null
exit 0
