@@ -1951,6 +1954,36 @@ pub const StreamHandler = struct {
     fn progressReport(self: *StreamHandler, report: terminal.osc.Command.ProgressReport) void {
         self.surfaceMessageWriter(.{ .progress_report = report });
     }
+
+    fn programStatus(self: *StreamHandler, cmd: terminal.osc.Command.ProgramStatus) void {
+        switch (cmd) {
+            .query => |terminator| self.programStatusQuery(terminator),
+
+            // The parser already validated the report, so the apprt can
+            // read the body without checking limits again.
+            .report => |report| if (apprt.surface.Message.WriteReq.init(
+                self.alloc,
+                report.data,
+            )) |req| {
+                self.surfaceMessageWriter(.{ .program_status = req });
+            } else |err| {
+                log.warn("error notifying surface of program status err={}", .{err});
+            },
+        }
+    }
+
+    /// Answer `OSC 7501 ; ?`. The reply is always the same fixed bytes,
+    /// ended with the query's terminator. The specification never allows
+    /// sending report contents back to the program.
+    fn programStatusQuery(self: *StreamHandler, terminator: terminal.osc.Terminator) void {
+        switch (terminator) {
+            inline else => |t| self.messageWriter(.{
+                .write_stable = "\x1b]7501;" ++
+                    terminal.osc.program_status.query_reply ++
+                    comptime t.string(),
+            }),
+        }
+    }
 };
 
 test "kitty clipboard read: targets-only never consumes a one-time grant" {
@@ -2027,3 +2060,41 @@ test "kitty clipboard write: oversized text replies EFBIG" {
     // forwarded to the macOS clipboard path.
     try testing.expect(mailbox.spsc.queue.pop(global.io()) == null);
 }
+
+test "program status: support query is answered with the same terminator" {
+    const testing = std.testing;
+
+    var mailbox = try termio.Mailbox.initSPSC(testing.allocator);
+    defer mailbox.deinit(testing.allocator);
+
+    var mutex: std.Io.Mutex = .init;
+    mutex.lockUncancelable(global.io());
+    defer mutex.unlock(global.io());
+
+    var renderer_state: renderer.State = .{
+        .mutex = &mutex,
+        .terminal = undefined,
+    };
+    var handler: StreamHandler = undefined;
+    handler.alloc = testing.allocator;
+    handler.termio_mailbox = &mailbox;
+    handler.renderer_state = &renderer_state;
+
+    inline for (.{
+        .{ terminal.osc.Terminator.bel, "\x07" },
+        .{ terminal.osc.Terminator.st, "\x1b\\" },
+    }) |case| {
+        handler.programStatusQuery(case[0]);
+
+        const msg = mailbox.spsc.queue.pop(global.io()).?;
+        defer msg.deinit();
+        switch (msg) {
+            .write_stable => |v| try testing.expectEqualStrings(
+                "\x1b]7501;" ++ terminal.osc.program_status.query_reply ++ case[1],
+                v,
+            ),
+            else => try testing.expect(false),
+        }
+    }
+    try testing.expect(mailbox.spsc.queue.pop(global.io()) == null);
+}
