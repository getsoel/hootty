+/// An OSC 7501 program status report. `data` is the body after `7501;`,
+/// such as `state=blocked:kind=permission:app=terraform:msg=<base64>`.
+/// The parser has already validated it against the specification. The
+/// apprt keeps one record per `id` and applies the lifetime rules. A
+/// full terminal reset arrives as `state=clear`.
+pub const ProgramStatus = struct {
+    data: [:0]const u8,
+
+    // Sync with: ghostty_action_program_status_s
+    pub const C = extern struct {
+        data: [*:0]const u8,
+    };
+
+    pub fn cval(self: ProgramStatus) C {
+        return .{
+            .data = self.data.ptr,
+        };
+    }
+};
